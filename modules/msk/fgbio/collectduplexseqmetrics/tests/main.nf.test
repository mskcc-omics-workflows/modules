nextflow_process {

    name "Test Process FGBIO_COLLECTDUPLEXSEQMETRICS"
    script "../main.nf"
    process "FGBIO_COLLECTDUPLEXSEQMETRICS"

    tag "modules"
    tag "modules_msk"
    tag "fgbio"
    tag "fgbio/collectduplexseqmetrics"

    test("chr22 - bam") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.test_data_mskcc['fgbio_collectduplexseqmetrics']['test_chr22_collapsed_grouped_bam'], checkIfExists: true),
                    file(params.test_data_mskcc['fgbio_collectduplexseqmetrics']['test_chr22_collapsed_grouped_bam_bai'], checkIfExists: true),
                    file(params.test_data_mskcc['fgbio_collectduplexseqmetrics']['test_chr22_interval_list'], checkIfExists: true)
                    ]
                """
            }
        }

        then {
            def size = path(process.out.family_size[0][1]).size()
            def lines = path(process.out.family_sizes[0][1]).readLines()[0..1]
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.family_sizes[0][1]).name,
                    size,
                    lines,
                    process.out.versions,
                    file(process.out.family_sizes[0][1]).name,
                    file(process.out.duplex_family_sizes[0][1]).name,
                    file(process.out.duplex_yield_metrics[0][1]).name,
                    file(process.out.umi_counts[0][1]).name,
                    file(process.out.duplex_umi_counts[0][1]).name
                    ).match()
                }
            )
        }
    }


    test("chr22 - bam - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.test_data_mskcc['fgbio_collectduplexseqmetrics']['test_chr22_collapsed_grouped_bam'], checkIfExists: true),
                    file(params.test_data_mskcc['fgbio_collectduplexseqmetrics']['test_chr22_collapsed_grouped_bam_bai'], checkIfExists: true),
                    file(params.test_data_mskcc['fgbio_collectduplexseqmetrics']['test_chr22_interval_list'], checkIfExists: true)
                    ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
