// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test fgbio/collectduplexseqmetrics
nextflow_process {

    name "Test Process FGBIO_COLLECTDUPLEXSEQMETRICS"
    script "../main.nf"
    process "FGBIO_COLLECTDUPLEXSEQMETRICS"

    tag "modules"
    tag "modules_msk"
    tag "fgbio"
    tag "fgbio/collectduplexseqmetrics"

    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used
    test("chr22 - bam") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.test_data_mskcc['calculate_noise']['test_chr22_bam'], checkIfExists: true),
                    file(params.test_data_mskcc['calculate_noise']['test_chr22_bam_bai'], checkIfExists: true),
                    file(params.test_data_mskcc['calculate_noise']['test_bed'], checkIfExists: true),
                    ]
                """
            }
        }

        then {
            def size = path(process.out.family_sizes.txt[0][1]).size()
            def lines = path(process.out.family_sizes.txt[0][1]).readLines()[0..1]
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.family_sizes.txt[0][1]).name,
                    size,
                    lines,
                    process.out.versions,
                    file(process.out.family_sizes.txt[0][1]).name,
                    file(process.out.duplex_family_sizes[0][1]).name,
                    file(process.out.duplex_yield_metrics[0][1]).name,
                    file(process.out.umi_counts[0][1]).name,
                    file(process.out.duplex_umi_counts[0][1]).name
                    ).match()
                }
            )
        }
    }


    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used but keep the " - stub" suffix.
    test("chr22 - bam - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.test_data_mskcc['calculate_noise']['test_chr22_bam'], checkIfExists: true),
                    file(params.test_data_mskcc['calculate_noise']['test_chr22_bam_bai'], checkIfExists: true),
                    file(params.test_data_mskcc['calculate_noise']['test_bed'], checkIfExists: true),
                    ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
