    test("netmhc3 - MUT,WT shared storeDir - no cross-collection - stub") {

        options "-stub"
        config "./storedir.config"

        when {
            process {
                """
                input[0] = Channel.of(
                    [
                        [ id:'test', single_end:false ], // meta map
                        file('MUT_sequence_fa'),
                        file('MUT_sv_fa'),
                        "HLA",
                        "MUT"
                    ],
                    [
                        [ id:'test', single_end:false ], // meta map
                        file('WT_sequence_fa'),
                        file('WT_sv_fa'),
                        "HLA",
                        "WT"
                    ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // both tasks ran and landed in the same storeDir folder
                { assert process.out.xls.size() == 2 },
                { assert process.out.netmhcoutput.size() == 2 },
                // each task emits exactly one file, not its sibling's as well
                { assert process.out.xls.every { !(it[1] instanceof List) } },
                { assert process.out.netmhcoutput.every { !(it[1] instanceof List) } },
                // and the file each task emits is its own
                { assert process.out.xls.every { meta, f ->
                    file(f).name == "test.${meta.typeMut ? 'MUT' : 'WT'}.xls" } },
                { assert process.out.netmhcoutput.every { meta, f ->
                    file(f).name == "test.${meta.typeMut ? 'MUT' : 'WT'}.netmhc.output" } },
                { assert process.out.xls.collect { file(it[1]).name }.sort() == ['test.MUT.xls', 'test.WT.xls'] },
                // the hla files are NOT disambiguated by inputType: both tasks write the same
                // two names, so the shared storeDir holds one copy of each and both tasks
                // legitimately collect the same pair. See README/meta.yml note.
                { assert process.out.netmhc_hla_files.every { meta, f ->
                    f.collect { file(it).name }.sort() == ['test.hla_accepted.txt', 'test.hla_rejected.txt'] } }
            )
        }

    }

    test("netmhc3 - xls,output,fa - stub") {

