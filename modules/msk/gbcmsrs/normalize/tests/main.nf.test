// nf-core modules test gbcmsrs/normalize
nextflow_process {

    name "Test Process GBCMSRS_NORMALIZE"
    script "../main.nf"
    process "GBCMSRS_NORMALIZE"

    tag "modules"
    tag "modules_msk"
    tag "gbcmsrs"
    tag "gbcmsrs/normalize"

    test("sarscov2 illumina - vcf - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.test_data['sarscov2']['illumina']['test_vcf'], checkIfExists: true)
                ]
                input[1] = file(params.test_data['sarscov2']['genome']['genome_fasta'], checkIfExists: true)
                input[2] = file(params.test_data['sarscov2']['genome']['genome_fasta_fai'], checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
