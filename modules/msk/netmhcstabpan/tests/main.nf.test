nextflow_process {

    name "Test Process NETMHCSTABPAN"
    script "../main.nf"
    process "NETMHCSTABPAN"

    tag "modules"
    tag "modules_nfcore"
    tag "netmhcstabpan"
    tag "modules_msk"

    test("netmhcstabpan - MUT,SV - xls,output,fa") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.test_data_mskcc['neoantigen']['MUT_sequence_fa'], checkIfExists: true),
                    file(params.test_data_mskcc['neoantigen']['MUT_sv_fa'], checkIfExists: true),
                    "HLA-A24:02,HLA-A24:02,HLA-B39:01,HLA-B39:01,HLA-C07:01,HLA-C06:02",
                    "MUT"
                    ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    process.out.netmhcstabpanoutput[0][0],
                    file(process.out.netmhcstabpanoutput[0][1]).name
                    ).match()
                }
            )
        }

    }

    test("netmhcstabpan - WT,SV - xls,output,fa") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
