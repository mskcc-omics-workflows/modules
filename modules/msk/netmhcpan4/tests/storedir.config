// Mirrors the production storeDir: keyed on process name + task.tag, so the MUT and WT
// tasks of one sample share a single output folder. Output globs must be narrow enough
// that each task collects only the file it wrote.
process {
    storeDir = { "${workflow.launchDir}/storeDir/${task.process.tokenize(':')[-1]}/${task.tag}/" }
}
