nextflow_process {

    name "Test Process CUSTOM_FILTEREDGEINDELS"
    script "../main.nf"
    process "CUSTOM_FILTEREDGEINDELS"

    tag "modules"
    tag "modules_msk"
    tag "custom"
    tag "custom/filteredgeindels"

    test("synthetic - bam - PR #288 edge indels") {
        config './nextflow.config'

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.test_data_mskcc['filteredgeindels']['edge_indels_bam'], checkIfExists: true),
                    file(params.test_data_mskcc['filteredgeindels']['edge_indels_bam_bai'], checkIfExists: true)
                ]
                """
            }
        }

        then {
            def flagged   = ['flag_end_di', 'flag_end_id', 'flag_end_sd', 'flag_start_di', 'flag_start_id', 'flag_start_si']
            def survivors = ['keep_hclip_start', 'keep_internal_del', 'keep_lone_end', 'keep_lone_start', 'keep_plain', 'keep_softclip', 'keep_unmapped']
            def outNames  = bam(process.out.bam[0][1]).getSamLines().findAll { !it.startsWith('@') }.collect { it.split('\t')[0] }
            def counts    = path(process.out.counts[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert path(process.out.qnames[0][1]).readLines().sort() == flagged },
                { assert counts[0] == "sample\tflagged_records\tflagged_pairs\tprimary_reads_in\tprimary_reads_out" },
                { assert counts[1] == "test\t6\t6\t26\t14" },
                { assert outNames.size() == 14 },
                { assert outNames.unique(false).sort() == survivors },
                { assert outNames.intersect(flagged).isEmpty() },
                { assert file(process.out.bai[0][1]).exists() },
                { assert snapshot(
                    bam(process.out.bam[0][1]).getReadsMD5(),
                    process.out.counts,
                    process.out.versions
                ).match() }
            )
        }
    }

    test("argos - bam - real ABRA2 output, nothing flagged") {
        config './nextflow.config'

        when {
            process {
                """
                input[0] = [
                    [ id:'argos_normal' ],
                    file(params.test_data_mskcc['argos']['test_argos_sample_1_normal_bam'], checkIfExists: true),
                    file(params.test_data_mskcc['argos']['test_argos_sample_1_normal_bam_bai'], checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.qnames[0][1]).readLines().isEmpty() },
                { assert path(process.out.counts[0][1]).readLines()[1] == "argos_normal\t0\t0\t298412\t298412" },
                { assert snapshot(
                    bam(process.out.bam[0][1]).getReadsMD5(),
                    process.out.counts,
                    process.out.versions
                ).match() }
            )
        }
    }

    test("synthetic - bam - prefix collides with input name") {
        config './prefix_collision.config'

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.test_data_mskcc['filteredgeindels']['edge_indels_bam'], checkIfExists: true),
                    file(params.test_data_mskcc['filteredgeindels']['edge_indels_bam_bai'], checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("Input and output names are the same") }
            )
        }
    }

    test("synthetic - bam - stub") {
        config './nextflow.config'

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.test_data_mskcc['filteredgeindels']['edge_indels_bam'], checkIfExists: true),
                    file(params.test_data_mskcc['filteredgeindels']['edge_indels_bam_bai'], checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
